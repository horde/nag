// ----------------------------------------------------------------------
// Storage System Settings
// ----------------------------------------------------------------------
// What storage driver should we use? ('sql' = SQL)
$conf['storage']['driver'] = 'sql';
// Database connection: 'horde' uses the global Horde DB, 'custom' uses settings below
