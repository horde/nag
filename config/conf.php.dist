// ----------------------------------------------------------------------
// Tasklist Handler Settings
// ----------------------------------------------------------------------
// What type of tasklist handler should we use? ('default' = Default)
$conf['tasklists']['driver'] = 'default';

// ----------------------------------------------------------------------
// Assignee Handling
// ----------------------------------------------------------------------
// Should we allow assingment of tasks to external users? This enables sending vTodo/iTip messages for task assignments....
$conf['assignees']['allow_external'] = false;

// ----------------------------------------------------------------------
// Menu settings
// ----------------------------------------------------------------------
// Should we display an Import/Export link in the Horde application menus?
$conf['menu']['import_export'] = true;
