    "require-dev": {},
    "suggest": {
        "horde/activesync": "^3 || dev-FRAMEWORK_6_0",
        "horde/backup": "^2 || dev-FRAMEWORK_6_0",
        "horde/db": "^3 || dev-FRAMEWORK_6_0",
        "horde/openxchange": "^2 || dev-FRAMEWORK_6_0",
        "horde/test": "^3 || dev-FRAMEWORK_6_0"
